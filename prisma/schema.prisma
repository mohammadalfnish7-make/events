generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://events_user:events_password@db:5432/events_db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id            String   @id @default(cuid())
  titleEn       String
  titleAr       String
  descriptionEn String   @db.Text
  descriptionAr String   @db.Text
  image         String?
  price         Float?
  isActive      Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Media {
  id        String    @id @default(cuid())
  filename  String
  path      String
  type      MediaType
  size      Int
  alt       String?
  createdAt DateTime  @default(now())
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
}

model PageView {
  id        String   @id @default(cuid())
  path      String?
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  EDITOR
}

enum MediaType {
  IMAGE
  VIDEO
}
